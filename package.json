{
  "name": "fremont-system-v2",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "sh -c 'pnpm --parallel --filter @fremont/web --filter @fremont/api dev; code=$?; [ $code -eq 0 ] || [ $code -eq 130 ] || [ $code -eq 143 ]'",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @fremont/api db:generate",
    "db:migrate": "pnpm --filter @fremont/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @fremont/api db:migrate:deploy",
    "db:seed": "pnpm --filter @fremont/api db:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.2"
  }
}
